# Base URL for the Recipe Explorer backend API.
# When not set, the frontend falls back to a local mock data layer defined
# in src/services/recipeService.js.
# Example: https://api.your-domain.com
REACT_APP_API_BASE=

# Existing environment variables used by the wider template / deployment
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_TRUST_PROXY=false
REACT_APP_LOG_LEVEL=info
REACT_APP_HEALTHCHECK_PATH=/health
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=false
